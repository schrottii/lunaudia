{
  "name": "lunaudia",
  "version": "1.4.1",
  "description": "Simple audio file player",
  "main": "code/node/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schrottii/lunaudia.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "package-linux-x64": "electron-packager . lunaudia --platform=linux --arch=x64 --out=out --overwrite",
    "package-linux-arm64": "electron-packager . lunaudia --platform=linux --arch=arm64 --out=out --overwrite",
    "make": "electron-forge make"
  },
  "author": "schrottii",
  "license": "All Rights Reserved",
  "bugs": {
    "url": "https://github.com/schrottii/lunaudia/issues"
  },
  "homepage": "https://github.com/schrottii/lunaudia#readme",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.3",
    "@electron-forge/plugin-fuses": "^7.8.3",
    "@electron/fuses": "^1.8.0",
    "electron": "37.3.0"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "music-metadata": "^7.12.3"
  }
}
